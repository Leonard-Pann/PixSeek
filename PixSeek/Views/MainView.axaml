<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:PixSeek.ViewModels" xmlns:views="using:PixSeek.Views" xmlns:loc="using:PixSeek.Localization" x:Class="PixSeek.Views.MainView" x:DataType="vm:MainViewModel" Background="{DynamicResource CanvasBrush}">
  <Grid x:Name="RootLayout">
    <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding !IsDialogOpen}">
      <Border IsVisible="{Binding HasError}" Background="#22E58467" CornerRadius="12" Margin="24,12" Padding="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxHeight="90" /><Button Grid.Column="1" Content="{loc:T Close}" Command="{Binding DismissErrorCommand}" /></Grid></Border>
      <Grid Grid.Row="1" RowDefinitions="*,Auto"><StackPanel Grid.Row="1" IsVisible="{Binding People.IsIndexing}" Orientation="Horizontal" Spacing="12" Margin="30,8"><ProgressBar IsIndeterminate="True" Width="100" Height="4" /><TextBlock Text="{Binding People.IndexStatus}" Classes="subtitle" /></StackPanel><Grid IsVisible="{Binding IsGallery}"><views:LibraryView DataContext="{Binding Library}" /></Grid><views:SettingsView IsVisible="{Binding IsSettings}" /></Grid>
      <Border Grid.Row="2" IsVisible="{Binding IsIndexing}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,8"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Status}" Classes="subtitle" FontSize="12" /><ProgressBar IsIndeterminate="{Binding IsIndexProgressIndeterminate}" Value="{Binding IndexProgress}" Height="4" /></StackPanel><Button Grid.Column="1" Content="{loc:T Pause}" Command="{Binding PauseIndexCommand}" Margin="12,0" /><Button Grid.Column="2" Content="{loc:T Cancel}" Command="{Binding CancelIndexCommand}" /></Grid></Border>
    </Grid>
    <Grid IsVisible="{Binding Viewer.IsOpen}"><views:MediaViewerView x:Name="ViewerOverlay" DataContext="{Binding Viewer}" /></Grid>
    <Grid x:Name="CompressionOverlay" IsVisible="{Binding IsCompressionDialogOpen}" Background="#99090C14">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="28" Width="760" MaxHeight="760" Margin="24" VerticalAlignment="Stretch" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"><views:CompressionDialogView DataContext="{Binding Optimizer}" /></Border>
    </Grid>
    <Grid x:Name="PersonOverlay" IsVisible="{Binding IsPersonDialogOpen}" Background="#99090C14">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="28" Width="760" MaxHeight="760" Margin="24" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"><views:PersonDialogView DataContext="{Binding People}" /></Border>
    </Grid>
  </Grid>
</UserControl>
