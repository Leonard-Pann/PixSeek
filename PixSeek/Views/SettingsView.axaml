<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:PixSeek.ViewModels" x:Class="PixSeek.Views.SettingsView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="36,12,36,36" Spacing="22">
    <Border Classes="card" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"><StackPanel Spacing="16"><TextBlock Text="Général" Classes="section" /><Grid ColumnDefinitions="160,*"><TextBlock Text="Apparence" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" /></Grid><TextBlock Text="Langue : Français" /><TextBlock Text="Cache des miniatures" FontWeight="SemiBold" /><TextBlock Text="{Binding CachePath}" Classes="subtitle" /><Button Content="Enregistrer les paramètres" Command="{Binding SaveCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Bibliothèques" Classes="section" /><TextBlock Text="Retirer un dossier enlève ses références et ses vecteurs. Les fichiers sur disque sont conservés." Classes="subtitle" /><WrapPanel><Button Content="Ajouter un dossier" Command="{Binding AddFolderCommand}" Margin="0,0,12,0" /><Button Content="Rescanner / reprendre" Command="{Binding RescanCommand}" Margin="0,0,12,0" /><Button Content="Tout réindexer" Command="{Binding ReindexCommand}" /></WrapPanel><ItemsControl ItemsSource="{Binding Library.Folders}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Classes="subtitle" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" Classes="subtitle" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><CheckBox Content="Sous-dossiers" IsChecked="{Binding Recursive, Mode=OneWay}" IsEnabled="False" /><Button Content="Modifier" Click="ToggleRecursive" /><Button Content="Retirer" Click="RemoveFolder" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border Classes="card" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"><StackPanel Spacing="14"><TextBlock Text="Intelligence artificielle locale" Classes="section" /><TextBlock Text="{Binding ModelName}" /><TextBlock Text="{Binding ModelStatus}" Classes="subtitle" /><TextBlock Text="{Binding ModelPath}" Classes="subtitle" /><WrapPanel><Button Content="Télécharger / vérifier le modèle" Classes="primary" Command="{Binding DownloadModelCommand}" Margin="0,0,12,0" /><Button Content="Annuler" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" /></WrapPanel><ProgressBar Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" Height="6" /><TextBlock Text="Le téléchargement initial requiert Internet. Les recherches fonctionnent ensuite hors ligne sur CPU." Classes="subtitle" /><WrapPanel><StackPanel Spacing="6" Margin="0,0,20,0"><TextBlock Text="Intervalle vidéo (secondes)" /><NumericUpDown Value="{Binding FrameInterval}" Minimum="1" Maximum="600" Width="180" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Frames maximum par vidéo" /><NumericUpDown Value="{Binding MaxFrames}" Minimum="1" Maximum="1000" Width="180" /></StackPanel></WrapPanel><Button Content="Enregistrer" Command="{Binding SaveCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
    <Border Classes="card" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"><StackPanel Spacing="14"><TextBlock Text="Diagnostics" Classes="section" /><TextBox Text="{Binding Diagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="monospace" FontSize="12" /><WrapPanel><Button Content="Ouvrir les logs" Command="{Binding OpenLogsCommand}" Margin="0,0,12,0" /><Button Content="Données de l'application" Command="{Binding OpenDataCommand}" /></WrapPanel><TextBlock Text="Lecture vidéo : FFplay embarqué dans une fenêtre externe. Espace : pause ; flèches : déplacement ; F : plein écran ; 9/0 : volume." Classes="subtitle" /></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
