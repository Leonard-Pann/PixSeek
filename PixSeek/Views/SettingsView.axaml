<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:PixSeek.ViewModels" xmlns:loc="using:PixSeek.Localization" x:Class="PixSeek.Views.SettingsView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="Auto,*" Margin="30,22"><Button Content="{loc:T Back}" Command="{Binding NavigateCommand}" CommandParameter="1" /><TextBlock Grid.Column="1" Text="{loc:T Settings}" Classes="title" Margin="20,0" VerticalAlignment="Center" /></Grid>
    <ScrollViewer Grid.Row="1"><StackPanel Margin="30,0,30,28" MaxWidth="1040" Spacing="20" HorizontalAlignment="Stretch">
      <Border Classes="card" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"><StackPanel Spacing="18">
        <TextBlock Text="{loc:T General}" Classes="section" />
        <Grid ColumnDefinitions="190,*"><TextBlock Text="{loc:T Theme}" VerticalAlignment="Center" /><ComboBox x:Name="ThemeChoice" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"><ComboBox.ItemTemplate><DataTemplate x:DataType="loc:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
        <Grid ColumnDefinitions="190,*"><TextBlock Text="{loc:T Language}" VerticalAlignment="Center" /><ComboBox x:Name="LanguageChoice" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"><ComboBox.ItemTemplate><DataTemplate x:DataType="loc:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
        <WrapPanel><Button Content="{loc:T ClearCache}" Command="{Binding ClearCachesCommand}" /><TextBlock Text="{Binding CacheStatus}" Margin="16,0" Classes="subtitle" VerticalAlignment="Center" /></WrapPanel>
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{loc:T Library}" Classes="section" /><WrapPanel><Button Content="{loc:T AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,12,0" /><Button Content="{loc:T ReindexAll}" Command="{Binding ReindexCommand}" /></WrapPanel>
        <ItemsControl ItemsSource="{Binding Library.Folders}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,8">
          <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Classes="subtitle" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"><ToggleSwitch Content="{loc:T Subfolders}" IsChecked="{Binding Recursive, Mode=OneWay}" IsCheckedChanged="ToggleRecursive" OnContent="" OffContent="" /><Button Content="{loc:T Remove}" Click="RemoveFolder" /></StackPanel>
        </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Classes="card" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"><StackPanel Spacing="18">
        <TextBlock Text="{loc:T AiModel}" Classes="section" />
        <ItemsControl ItemsSource="{Binding Models}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ModelOptionViewModel"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,18"><Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="subtitle" FontSize="12" /><TextBlock Text="{Binding InstallStatus}" Classes="subtitle" FontSize="12" /></StackPanel>
          <Button Grid.Column="1" Content="{Binding ManageLabel}" Command="{Binding ManageCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanManage}" Margin="12,0,20,0" VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsActive}" IsEnabled="{Binding CanSelect}" OnContent="" OffContent="" ToolTip.Tip="{loc:T UseModel}" VerticalAlignment="Center" />
        </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel IsVisible="{Binding IsModelBusy}" Spacing="8"><ProgressBar Value="{Binding DownloadProgress}" Height="5" /><Button Content="{loc:T Cancel}" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Left" /></StackPanel>
        <TextBlock Text="{Binding ModelStatus}" Classes="subtitle" FontSize="12" />
        <WrapPanel><StackPanel Spacing="8" Margin="0,0,24,0"><TextBlock Text="{loc:T VideoInterval}" /><NumericUpDown Value="{Binding FrameInterval}" Minimum="1" Maximum="600" Width="200" /></StackPanel><StackPanel Spacing="8"><TextBlock Text="{loc:T MaxFrames}" /><NumericUpDown Value="{Binding MaxFrames}" Minimum="1" Maximum="1000" Width="200" /></StackPanel></WrapPanel>
      </StackPanel></Border>
      <TextBlock Text="{Binding Settings.Version}" Classes="subtitle" FontSize="12" HorizontalAlignment="Center" />
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
