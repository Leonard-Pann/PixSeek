<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:PixSeek.ViewModels" xmlns:controls="using:PixSeek.Controls" xmlns:loc="using:PixSeek.Localization" x:Class="PixSeek.Views.LibraryView" x:DataType="vm:LibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="30,26,30,16">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,18">
      <TextBox x:Name="SearchInput" Text="{Binding Query}" PlaceholderText="{loc:T SearchPlaceholder}" FontSize="17" MinHeight="54" VerticalContentAlignment="Center" KeyDown="SearchKeyDown"><TextBox.InnerRightContent><Button x:Name="ClearQueryButton" Content="✕" Command="{Binding ClearQueryCommand}" IsVisible="{Binding HasQuery}" Background="Transparent" Padding="10" Margin="4" ToolTip.Tip="{loc:T ClearSearch}" /></TextBox.InnerRightContent></TextBox>
      <Button Grid.Column="1" Content="{loc:T Search}" Classes="primary" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsSearchBlocked}" Margin="12,0,0,0" />
      <Button Grid.Column="2" Content="{loc:T AddFolder}" Command="{Binding AddFolderCommand}" Margin="12,0,0,0" />
      <Button Grid.Column="3" x:Name="OpenSettingsButton" Content="⚙" Command="{Binding SettingsCommand}" Margin="10,0,0,0" ToolTip.Tip="{loc:T Settings}" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,14">
      <WrapPanel>
        <ComboBox x:Name="MediaTypeFilter" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedTypeChoice}" Margin="0,0,10,8" ToolTip.Tip="{loc:T AllMedia}"><ComboBox.ItemTemplate><DataTemplate x:DataType="loc:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <ComboBox x:Name="FolderFilter" ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolder}" PlaceholderText="{loc:T AllFolders}" MaxWidth="220" MinWidth="170" Margin="0,0,10,8" ToolTip.Tip="{loc:T AllFolders}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSortChoice}" Margin="0,0,10,8" ToolTip.Tip="{loc:T Date}"><ComboBox.ItemTemplate><DataTemplate x:DataType="loc:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button Content="{loc:T ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,10,8" />
        <Button x:Name="AddPersonButton" Content="{loc:T AddPerson}" Command="{Binding PersonCommand}" Margin="0,0,10,8" /><Button x:Name="CompressButton" Content="{loc:T Compress}" Command="{Binding CompressCommand}" Margin="0,0,0,8" />
      </WrapPanel>
      <TextBlock Text="{Binding Summary}" Classes="subtitle" FontSize="12" />
      <Border Height="3"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" /></Border>
    </StackPanel>
    <controls:MediaGallery Grid.Row="2" x:Name="GalleryList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="GallerySizeChanged">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.Styles>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MediaRow">
          <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MediaCardViewModel">
                <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Margin="4" ClipToBounds="True">
                  <Grid RowDefinitions="180,Auto">
                    <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource SidebarBrush}" CornerRadius="12" Click="OpenMedia" ToolTip.Tip="{Binding Details}">
                      <Button.ContextMenu><ContextMenu><MenuItem Header="{loc:T Read}" Click="OpenFromMenu" /><MenuItem Header="{loc:T Compress}" Click="OptimizeFile" /><MenuItem Header="{loc:T OpenLocation}" Click="OpenLocation" /></ContextMenu></Button.ContextMenu>
                      <Grid><TextBlock Text="◇" FontSize="38" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><controls:AsyncThumbnail FilePath="{Binding ThumbnailPath}" Stretch="UniformToFill" /><Border Background="#B3181B28" CornerRadius="6" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" IsVisible="{Binding IsVideo}"><TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" /></Border></Grid>
                    </Button>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" ToolTip.Tip="{loc:T SelectMedia}" />
                    <StackPanel Grid.Row="1" Margin="10,7,10,10" Spacing="3"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" /></StackPanel>

    </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </controls:MediaGallery>
  </Grid>
</UserControl>
