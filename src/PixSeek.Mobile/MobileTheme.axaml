<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PixSeek.Mobile.MobileTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MobileCanvas">#FAFAFF</SolidColorBrush>
          <SolidColorBrush x:Key="MobileSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MobileInk">#26243B</SolidColorBrush>
          <SolidColorBrush x:Key="MobileMuted">#77748F</SolidColorBrush>
          <SolidColorBrush x:Key="MobileLine">#ECEAF5</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MobileCanvas">#14151E</SolidColorBrush>
          <SolidColorBrush x:Key="MobileSurface">#20212E</SolidColorBrush>
          <SolidColorBrush x:Key="MobileInk">#F4F1FF</SolidColorBrush>
          <SolidColorBrush x:Key="MobileMuted">#B4AEC8</SolidColorBrush>
          <SolidColorBrush x:Key="MobileLine">#323243</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MobileInk}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="23" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,16,0,4" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource MobileMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="48" /><Setter Property="MinWidth" Value="48" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="14,10" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#7770E4" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.wide"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="MinHeight" Value="66" /><Setter Property="Background" Value="{DynamicResource MobileCanvas}" /></Style>
  <Style Selector="Button.viewer"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="24" /></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="48" /><Setter Property="CornerRadius" Value="14" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="50" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="14,12" /><Setter Property="FontSize" Value="16" /></Style>
  <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource MobileSurface}" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="16" /></Style>
  <Style Selector="ListBox.gallery"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.gallery ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ListBox.gallery ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBox.gallery ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
</Styles>
